# MoveScout MCP Server - nginx reverse proxy configuration
# Copy to /etc/nginx/conf.d/ or sites-available and customize

upstream movescout_mcp {
    server 127.0.0.1:8080;  # TrueNAS Docker host port
    keepalive 32;
}

server {
    listen 80;
    server_name mspmcp.jbeckstead.com;

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mspmcp.jbeckstead.com;

    # TLS certificates (Let's Encrypt via certbot or Nginx Proxy Manager)
    ssl_certificate /etc/letsencrypt/live/mspmcp.jbeckstead.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mspmcp.jbeckstead.com/privkey.pem;

    # Modern TLS configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    # HSTS (optional but recommended)
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Health check endpoint
    location /health {
        proxy_pass http://movescout_mcp/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MCP endpoint (Streamable HTTP)
    location /mcp {
        proxy_pass http://movescout_mcp/mcp;
        proxy_http_version 1.1;

        # Required for Streamable HTTP / SSE
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        # Pass auth header through
        proxy_set_header Authorization $http_authorization;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeout for streaming
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Deny direct access to any other paths
    location / {
        return 404;
    }
}
