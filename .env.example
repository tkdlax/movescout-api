# Database
DATABASE_URL=postgresql+asyncpg://movescout:changeme@postgres:5432/movescout

# Fernet key for encrypting MoveScout passwords at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# MoveScout Pro API host (API calls — NOT the web UI)
MOVESCOUT_BASE_URL=https://movescoutproapi.sirva.com
# Web app Origin header (browser login site)
MOVESCOUT_ORIGIN=https://movescoutpro.sirva.com
# Chrome on Windows User-Agent (override to match your browser if needed)
MOVESCOUT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36

# Application
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Comma-separated IPs/CIDRs trusted for X-Forwarded-* headers (nginx, ALB, etc.)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Rate limiting (requests per minute per API key)
RATE_LIMIT_PER_MINUTE=60

# Set to true in production to disable public /docs and /redoc
DISABLE_PUBLIC_DOCS=false

# Postgres (used by docker-compose only)
POSTGRES_USER=movescout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=movescout

# TrueNAS: absolute path to cloned repo (for Postgres host volume)
# APP_DATA_PATH=/mnt/tank/apps/movescout-api
